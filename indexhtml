<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALJABAR ARENA: BATTLE OF THE BRAINS</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QRCode.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Rajdhani:wght@500;600;700&display=swap');
        
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        
        .pixel-font {
            font-family: 'Press Start 2P', cursive;
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .neon-border {
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
        }

        .neon-text {
            text-shadow: 0 0 10px rgba(59, 130, 246, 0.8);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-4 bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950">

    <!-- Header / Navbar -->
    <header class="max-w-7xl w-full mx-auto flex justify-between items-center py-4 px-6 glass-card rounded-2xl mb-6">
        <div class="flex items-center space-x-3">
            <i class="fa-solid fa-gamepad text-3xl text-indigo-500"></i>
            <div>
                <h1 class="text-xl md:text-2xl font-bold tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
                    ALJABAR ARENA
                </h1>
                <p class="text-xs text-slate-400 tracking-widest uppercase">Battle of the Brains</p>
            </div>
        </div>
        <div id="connectionStatus" class="flex items-center space-x-2 text-xs font-semibold px-3 py-1.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700">
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse" id="statusDot"></span>
            <span id="statusText">Memuat Firebase...</span>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl w-full mx-auto flex-grow flex flex-col justify-center items-center">

        <!-- VIEW 1: SELECT ROLE -->
        <div id="roleSelectionView" class="w-full max-w-md glass-card p-8 rounded-3xl text-center shadow-2xl border border-slate-800">
            <h2 class="text-2xl font-bold mb-2 text-slate-100">Selamat Datang!</h2>
            <p class="text-slate-400 mb-8 text-sm">Pilih peran Anda untuk memulai permainan interaktif Aljabar.</p>

            <div class="space-y-4">
                <button onclick="selectRole('host')" class="w-full py-4 px-6 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold rounded-xl shadow-lg transition duration-200 transform hover:-translate-y-0.5 flex items-center justify-center space-x-3">
                    <i class="fa-solid fa-desktop text-xl"></i>
                    <span>Masuk Sebagai HOST (Guru)</span>
                </button>
                <button onclick="selectRole('player')" class="w-full py-4 px-6 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl border border-slate-700 transition duration-200 flex items-center justify-center space-x-3">
                    <i class="fa-solid fa-user-ninja text-xl text-cyan-400"></i>
                    <span>Masuk Sebagai PESERTA (Siswa)</span>
                </button>
            </div>
        </div>

        <!-- VIEW 2: HOST LOBBY -->
        <div id="hostLobbyView" class="w-full max-w-4xl glass-card p-8 rounded-3xl hidden border border-indigo-500/30 neon-border">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                
                <!-- Left: QR Code & Room Code -->
                <div class="flex flex-col items-center justify-center p-6 bg-slate-900/80 rounded-2xl border border-slate-800 text-center">
                    <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase mb-1">Pindai Kode QR Ini</span>
                    <h3 class="text-sm text-slate-400 mb-4">Gunakan kamera HP untuk bergabung cepat</h3>
                    
                    <!-- QR Container -->
                    <div class="p-4 bg-white rounded-2xl shadow-inner mb-4 flex justify-center items-center">
                        <div id="qrcode"></div>
                    </div>

                    <div class="w-full pt-4 border-t border-slate-800">
                        <p class="text-xs text-slate-400 mb-1">Atau masukkan Kode Ruangan secara manual:</p>
                        <div class="text-3xl pixel-font tracking-widest text-cyan-400 bg-slate-950 py-2 px-4 rounded-xl border border-slate-800 inline-block font-bold" id="roomCodeDisplay">
                            ------
                        </div>
                    </div>
                </div>

                <!-- Right: Player Count & Joined List -->
                <div class="flex flex-col h-full justify-between space-y-6">
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold text-slate-100 flex items-center gap-2">
                                <i class="fa-solid fa-users text-indigo-400"></i>
                                Peserta Terhubung
                            </h3>
                            <!-- Real-time Count Counter -->
                            <span class="px-4 py-1.5 bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 font-bold text-lg rounded-full" id="playerCountBadge">
                                0 Peserta
                            </span>
                        </div>

                        <!-- Real-time Player List -->
                        <div id="playerList" class="bg-slate-900/60 rounded-2xl p-4 border border-slate-800 h-64 overflow-y-auto space-y-2">
                            <p class="text-slate-500 text-sm text-center py-8" id="emptyPlayerState">
                                Menunggu peserta memindai QR Code atau memasukkan kode ruangan...
                            </p>
                        </div>
                    </div>

                    <button onclick="startGame()" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold text-lg rounded-xl shadow-lg transition duration-200 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-play"></i>
                        <span>Mulai Permainan</span>
                    </button>
                </div>

            </div>
        </div>

        <!-- VIEW 3: PLAYER JOIN FORM -->
        <div id="playerJoinView" class="w-full max-w-md glass-card p-8 rounded-3xl hidden border border-slate-800">
            <h2 class="text-2xl font-bold mb-2 text-slate-100 text-center">Bergabung Permainan</h2>
            <p class="text-slate-400 mb-6 text-sm text-center">Masukkan nama Anda dan kode ruangan untuk mulai.</p>

            <form id="joinForm" onsubmit="handlePlayerJoin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Nama Lengkap / Panggilan</label>
                    <input type="text" id="playerNameInput" required placeholder="Contoh: Budi Aljabar" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-slate-100 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Kode Ruangan</label>
                    <input type="text" id="roomCodeInput" required placeholder="Contoh: 123456" maxlength="6" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-cyan-400 font-bold pixel-font text-center uppercase focus:outline-none focus:border-indigo-500 transition">
                </div>
                <button type="submit" class="w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg transition duration-200 mt-2">
                    Masuk Ruangan
                </button>
            </form>
        </div>

        <!-- VIEW 4: PLAYER WAITING ROOM -->
        <div id="playerWaitingView" class="w-full max-w-md glass-card p-8 rounded-3xl text-center hidden border border-slate-800">
            <div class="w-16 h-16 bg-indigo-500/20 text-indigo-400 rounded-full flex items-center justify-center mx-auto mb-4 border border-indigo-500/30">
                <i class="fa-solid fa-spinner animate-spin text-2xl"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-100 mb-2">Anda Sudah Terhubung!</h2>
            <p class="text-slate-400 text-sm mb-6">Menunggu Guru/Host memulai permainan di layar utama...</p>
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
                <span class="text-xs text-slate-500 uppercase block mb-1">Nama Pemain</span>
                <span class="font-bold text-indigo-400 text-lg" id="joinedPlayerName">-</span>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="max-w-7xl w-full mx-auto text-center py-4 text-xs text-slate-500">
        &copy; ALJABAR ARENA - Battle of the Brains. Dynamic Realtime Interactive Game.
    </footer>

    <!-- Game Logic Script -->
    <script>
        // --- 1. FIREBASE CONFIGURATION ---
        // Konfigurasi Default Firebase Realtime Database
        const firebaseConfig = {
            databaseURL: "https://aljabar-arena-default-rtdb.firebaseio.com"
        };

        // Initialize Firebase
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.database();

        // Check Firebase Connection Status
        db.ref(".info/connected").on("value", (snap) => {
            const statusDot = document.getElementById("statusDot");
            const statusText = document.getElementById("statusText");
            if (snap.val() === true) {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500";
                statusText.innerText = "Firebase Terhubung";
                statusText.className = "text-emerald-400 font-semibold";
            } else {
                statusDot.className = "w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse";
                statusText.innerText = "Menghubungkan...";
                statusText.className = "text-yellow-400 font-semibold";
            }
        });

        // --- 2. GLOBAL STATE ---
        let currentRoomCode = null;
        let currentPlayerId = null;
        let playersRef = null;

        // Auto-detect Room Parameter from URL (If scanned via QR Code)
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const roomParam = urlParams.get('room');
            if (roomParam) {
                selectRole('player');
                document.getElementById('roomCodeInput').value = roomParam.toUpperCase();
            }
        });

        // --- 3. UI VIEW SWITCHER ---
        function showView(viewId) {
            const views = ['roleSelectionView', 'hostLobbyView', 'playerJoinView', 'playerWaitingView'];
            views.forEach(id => {
                const el = document.getElementById(id);
                if (id === viewId) {
                    el.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                }
            });
        }

        function selectRole(role) {
            if (role === 'host') {
                setupHostLobby();
            } else {
                showView('playerJoinView');
            }
        }

        // --- 4. HOST FUNCTIONS ---
        function generateRoomCode() {
            return Math.floor(100000 + Math.random() * 900000).toString();
        }

        function setupHostLobby() {
            currentRoomCode = generateRoomCode();
            document.getElementById('roomCodeDisplay').innerText = currentRoomCode;

            // Generate full URL with parameters for QR scanning
            const baseUrl = window.location.origin + window.location.pathname;
            const joinUrl = `${baseUrl}?room=${currentRoomCode}`;

            // Generate QR Code
            const qrContainer = document.getElementById("qrcode");
            qrContainer.innerHTML = ""; // Clear previous QR Code if any
            new QRCode(qrContainer, {
                text: joinUrl,
                width: 140,
                height: 140,
                colorDark: "#0f172a",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });

            // Initialize Room in Firebase
            const roomRef = db.ref(`rooms/${currentRoomCode}`);
            roomRef.set({
                created: Date.now(),
                status: 'waiting'
            });

            // Listen to Players Joining Real-time
            playersRef = db.ref(`rooms/${currentRoomCode}/players`);
            playersRef.on('value', (snapshot) => {
                const players = snapshot.val() || {};
                updatePlayerListUI(players);
            });

            showView('hostLobbyView');
        }

        function updatePlayerListUI(players) {
            const playerListEl = document.getElementById('playerList');
            const playerCountBadge = document.getElementById('playerCountBadge');
            
            const playerKeys = Object.keys(players);
            const count = playerKeys.length;

            playerCountBadge.innerText = `${count} Peserta`;

            if (count === 0) {
                playerListEl.innerHTML = `
                    <p class="text-slate-500 text-sm text-center py-8" id="emptyPlayerState">
                        Menunggu peserta memindai QR Code atau memasukkan kode ruangan...
                    </p>
                `;
                return;
            }

            playerListEl.innerHTML = "";
            playerKeys.forEach((key, index) => {
                const player = players[key];
                const playerItem = document.createElement('div');
                playerItem.className = "flex justify-between items-center p-3 bg-slate-800/80 rounded-xl border border-slate-700/50 animate-fade-in";
                playerItem.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <span class="w-7 h-7 flex items-center justify-center bg-indigo-500/20 text-indigo-400 font-bold rounded-lg text-xs">
                            ${index + 1}
                        </span>
                        <span class="font-semibold text-slate-200">${escapeHtml(player.name)}</span>
                    </div>
                    <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
                        <i class="fa-solid fa-check text-[10px] mr-1"></i> Terhubung
                    </span>
                `;
                playerListEl.appendChild(playerItem);
            });
        }

        // --- 5. PLAYER FUNCTIONS ---
        function handlePlayerJoin(e) {
            e.preventDefault();
            const name = document.getElementById('playerNameInput').value.trim();
            const code = document.getElementById('roomCodeInput').value.trim().toUpperCase();

            if (!name || !code) return;

            // Verify if Room exists
            db.ref(`rooms/${code}`).once('value', (snapshot) => {
                if (snapshot.exists()) {
                    currentRoomCode = code;
                    const newPlayerRef = db.ref(`rooms/${code}/players`).push();
                    currentPlayerId = newPlayerRef.key;

                    newPlayerRef.set({
                        name: name,
                        joinedAt: Date.now()
                    });

                    // Remove player automatically on disconnect
                    newPlayerRef.onDisconnect().remove();

                    document.getElementById('joinedPlayerName').innerText = name;
                    showView('playerWaitingView');
                } else {
                    alert('Kode Ruangan tidak ditemukan. Silakan periksa kembali!');
                }
            });
        }

        function startGame() {
            if (!currentRoomCode) return;
            db.ref(`rooms/${currentRoomCode}`).update({ status: 'playing' });
            alert('Permainan Dimulai!');
        }

        // Utility to prevent XSS
        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
